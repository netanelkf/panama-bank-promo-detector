{
  "name": "panama-bank-promo-detector",
  "version": "1.0.0",
  "description": "Detecta promociones de compra de saldo de tarjeta de credito en bancos de Panama y notifica a usuarios suscritos",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "seed": "knex seed:run",
    "scrape": "node src/scripts/runScrapeOnce.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "axios": "^1.15.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "expo-server-sdk": "^6.1.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.5",
    "express-validator": "^7.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.2.9",
    "morgan": "^1.10.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^8.0.5",
    "pg": "^8.20.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "engines": {
    "node": ">=20"
  }
}
