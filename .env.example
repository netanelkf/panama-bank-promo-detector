# Server
PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/panama_bank_promos

# JWT — REQUIRED, at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Scraper schedule (node-cron syntax) and its timezone. Default: every 6 hours.
SCRAPE_CRON=0 */6 * * *
SCRAPE_TZ=America/Panama
# Set to false if an external scheduler runs `npm run scrape` instead
# (recommended on hosts that sleep idle web services, e.g. Render free tier).
RUN_CRON=true

# Email (nodemailer) — Gmail app password or another SMTP provider.
# Port 465 uses implicit TLS; 587 uses STARTTLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
# Optional sender override, e.g. "Promos Bancarias PA" <alertas@tudominio.com>
SMTP_FROM=

# Expo push notifications are handled automatically via expo-server-sdk.
# Users register their Expo push token via PATCH /auth/me
# with { expo_push_token: "ExponentPushToken[...]" }
